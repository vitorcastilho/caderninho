# Supabase (Story 1.3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Story 1.3; pooler local na Story 1.13)
# Pelo pooler local em modo transação — mesmo caminho de staging/produção (6543).
# Confira a URL do pooler com `npm run db:status`.
DATABASE_URL=postgresql://postgres.pooler-dev:postgres@127.0.0.1:54329/postgres

# Better Auth (Story 1.4)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Story 1.5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Environment
NODE_ENV=development
ENVIRONMENT=development
